{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PSA_BACKEND=http://127.0.0.1:8010", "npm", "--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5273"],
      "port": 5273
    }
  ]
}
